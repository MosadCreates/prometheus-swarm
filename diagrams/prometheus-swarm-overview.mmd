graph LR
  subgraph INPUT["User Input"]
    UPD["Problem Description<br/>(natural language)"]
    UDS["Dataset CSV<br/>(data/*.csv)"]
  end

  subgraph ORCH["Orchestrator Layer"]
    OR["OrchestratorRuntime<br/>event-driven loop"]
    JQ["Job Queue<br/>submit / status / update"]
    PLW["Patch Log Writer<br/>BLPOP → patch_log.jsonl"]
    HM["Health Monitor<br/>heartbeat TTL 60s"]
  end

  subgraph AGENTS["Agents (6 specialized AI agents)"]
    SCOUT["Scout Agent<br/>Perceiver"]
    FORGE["Forge Agent<br/>Architect"]
    FURNACE["Furnace Agent<br/>Trainer"]
    DISSECT["Dissect Agent<br/>Debugger"]
    ARBITER["Arbiter Agent<br/>Critic"]
    HARBOR["Harbor Agent<br/>Deployer"]
  end

  subgraph BUS["Redis Streams (9 streams)"]
    SSCOUT["scout_output"]
    SFORGE["forge_output"]
    SFEED["furnace_feed"]
    SFURN["furnace_output"]
    SCRASH["furnace_crash"]
    SDISS["dissect_output"]
    SARB["arbiter_output"]
    SHARB["harbor_output"]
    SORCH["orchestrator_output"]
  end

  subgraph STORE["Storage Layer"]
    REDIS["Redis<br/>job:* keys, streams,<br/>patch_log_queue"]
    CHROMA["ChromaDB<br/>patch_memory<br/>architecture_memory<br/>tool_memory"]
  end

  subgraph DOCKER["Docker Infrastructure"]
    DC["docker-compose.yml<br/>Redis 6379, ChromaDB 8000"]
    TRC["Training Container<br/>prometheus-training-base<br/>mounts: scripts/ data/ outputs/"]
    SAC["Sandbox Container<br/>60s timeout, 3 epochs max<br/>same image/volumes"]
    SVC["Serving Container<br/>FastAPI + ONNX/Pickle<br/>auto port 8080+"]
  end

  subgraph MON["Monitoring"]
    PROM["Prometheus<br/>port 9090"]
    GRAF["Grafana Dashboard"]
    MET["28 Prometheus metrics<br/>agent lifecycle, pipeline,<br/>dissect, harbor"]
  end

  subgraph FE["Frontend"]
    FENEXT["Next.js App<br/>/feed SSE, /jobs, /drift"]
  end

  subgraph OUTPUT["Output"]
    EP["Live Model Endpoint<br/>/predict POST, /health GET,<br/>/metrics GET"]
    DRIFT["Drift Monitor<br/>PSI check hourly<br/>threshold 0.2"]
  end

  UPD --> OR
  UDS --> OR
  OR -->|submit_job| JQ
  JQ -->|MISSION_BRIEF_READY| SSCOUT

  SSCOUT --> SCOUT
  SCOUT -->|MISSION_BRIEF_READY| SFORGE
  FORGE -->|TRAINING_SCRIPT_READY| SFURN
  FURNACE -->|CRASH_EVENT| SCRASH
  DISSECT -->|RESUME_TRAINING / ESCALATE| SDISS
  FURNACE -->|TRAINING_COMPLETE| SARB
  ARBITER -->|EVALUATION_PASS / EVALUATION_RETRY / ESCALATE| SHARB
  HARBOR -->|ENDPOINT_LIVE / DRIFT_ALERT| SORCH

  SCOUT -->|writes| REDIS
  FORGE -->|queries| CHROMA
  FURNACE -->|launches| TRC
  DISSECT -->|queries| CHROMA
  DISSECT -->|launches| SAC
  DISSECT -->|writes patch_log| REDIS
  PLW -->|drains to| REDIS
  REDIS -->|patch_log.jsonl| PLW
  ARBITER -->|stores outcome| CHROMA
  HARBOR -->|builds & deploys| SVC
  HARBOR -->|configures| DRIFT
  HARBOR -->|publishes ENDPOINT_LIVE| SORCH

  TRC -->|streams epoch metrics| SFEED
  SFEED -->|EPOCH_COMPLETE| FENEXT

  OR -->|monitors| HM
  HM -->|AGENT_HEARTBEAT_EVENT| SORCH

  SVC -->|/metrics| PROM
  PROM --> GRAF
  PROM --> MET

  DRIFT -->|DRIFT_ALERT| SHARB
  SHARB -->|DRIFT_ALERT| OR
  OR -->|retrain cycle| JQ

  OR -->|sets status| REDIS

  SCOUT -.->|retry loop| FORGE
  ARBITER -.->|EVALUATION_RETRY| FORGE

  HARBOR --> EP

  style INPUT fill:#d4f1f9
  style ORCH fill:#f9f3d4
  style AGENTS fill:#e8d4f9
  style BUS fill:#f9d4d4
  style STORE fill:#d4f9d4
  style DOCKER fill:#d4d4f9
  style MON fill:#f9e0d4
  style FE fill:#f0f0f0
  style OUTPUT fill:#d4f9e8
