graph LR
  subgraph DOCKER_COMPOSE["docker-compose.yml"]
    REDIS_SVC["Redis Service<br/>image: redis:7.2-alpine<br/>port: 6379<br/>appendonly: yes<br/>volume: redis_data"]
    CHROMA_SVC["ChromaDB Service<br/>image: chromadb/chroma:0.5.0<br/>port: 8000<br/>ALLOW_RESET: true<br/>volume: chroma_data"]
    REDIS_HC["Healthcheck<br/>redis-cli ping"]
    CHROMA_HC["Healthcheck<br/>curl localhost:8000/api/v1/heartbeat"]

    REDIS_SVC --- REDIS_HC
    CHROMA_SVC --- CHROMA_HC
  end

  subgraph TRAINING["Training Container"]
    TC["prometheus-training-base<br/>FROM python:3.11-slim<br/><br/>Installed:<br/>lightgbm 4.3.0<br/>xgboost 2.0.3<br/>scikit-learn 1.4.2<br/>pandas 2.2.2<br/>torch 2.3.0<br/>transformers 4.41.0<br/>optuna 3.6.1<br/>imbalanced-learn 0.12.3<br/><br/>Entrypoint: python<br/>Name: train-{job_id}"]
    T_MOUNTS["Volumes:<br/>scripts/ → /app/scripts (ro)<br/>data/ → /app/data (ro)<br/>outputs/ → /app/outputs (rw)"]
    T_ENV["Env Vars:<br/>JOB_ID, DATA_DIR, OUTPUTS_DIR<br/>RESUME_CHECKPOINT<br/>SEARCH_SPACE_JSON"]

    TC --- T_MOUNTS
    TC --- T_ENV
  end

  subgraph SANDBOX["Sandbox Container"]
    SAC["prometheus-training-base<br/>same image, isolated container<br/><br/>Timeout: 60s<br/>Max epochs: 3<br/>Name: prometheus-sandbox-{job_id}-{random8}<br/>Launched by: Dissect"]
    SA_MOUNTS["Volumes:<br/>patched script (ro)<br/>data/ (ro)<br/>outputs/ (rw)"]
    SA_TIMEOUT["Sandbox test passes:<br/>script executes without<br/>raising original exception<br/>within 60s"]

    SAC --- SA_MOUNTS
    SAC --- SA_TIMEOUT
  end

  subgraph SERVING["Serving Container"]
    SVC["prometheus-model-{short_id}<br/>FROM python:3.11-slim<br/>Built on-the-fly by Harbor<br/><br/>Installed:<br/>fastapi, uvicorn<br/>onnxruntime<br/>numpy, pandas<br/>prometheus-client<br/>scikit-learn, joblib<br/><br/>Port: auto (starting 8080)<br/>Restart: unless-stopped"]
    S_APP["FastAPI App:<br/>POST /predict → ONNX inference<br/>GET /health → readiness<br/>GET /metrics → Prometheus<br/><br/>Preprocessing config loaded<br/>from model_preprocess.json<br/>Fallback: pickle if ONNX fails"]
    S_MON["Drift Monitor Loop<br/>PSI check every hour<br/>Threshold: 0.2<br/>On alert → DRIFT_ALERT event"]

    SVC --- S_APP
    SVC --- S_MON
  end

  subgraph PORTS["Port Map"]
    P6379["6379 ← Redis"]
    P8000["8000 ← ChromaDB"]
    P8080["8080+ ← Serving (auto)"]
    P9090["9090 ← Prometheus metrics"]
    P3000["3000 ← Frontend Next.js"]
  end

  subgraph NETWORK["Network Topology"]
    COMPOSE["Docker Compose network"]
    CONT["Containers communicate via<br/>internal Docker networking<br/>(service names as hostnames)"]
    HOST["Host machine<br/>exposes ports 6379, 8000,<br/>8080+, 9090, 3000"]
    COMPOSE --- CONT
    CONT --- HOST
  end

  subgraph K8S["Kubernetes (optional deployment)"]
    DEPLOY["Deployment: prometheus-serving<br/>2 replicas<br/>requests: 250m CPU / 512Mi RAM<br/>limits: 500m CPU / 1Gi RAM"]
    SERVICE["Service: LoadBalancer<br/>port 80 → 8080"]
    DEPLOY --> SERVICE
  end

  DOCKER_COMPOSE --> TRAINING
  DOCKER_COMPOSE --> SANDBOX
  DOCKER_COMPOSE --> SERVING
  DOCKER_COMPOSE --> PORTS

  style DOCKER_COMPOSE fill:#d4d4f9
  style TRAINING fill:#d4f9d4
  style SANDBOX fill:#f9d4d4
  style SERVING fill:#d4f1f9
  style PORTS fill:#f0f0f0
  style NETWORK fill:#e8d4f9
  style K8S fill:#f9f3d4
