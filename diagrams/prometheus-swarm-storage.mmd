graph TD
  subgraph REDIS["Redis (port 6379, 7.2-alpine)"]
    JOB_KEYS["job:* keys<br/>- mission_brief<br/>- file_path<br/>- problem_description<br/>- search_space<br/>- status<br/>- current_agent<br/>- checkpoint<br/>- crash_count<br/>- retry_count<br/>- api_cost (list)<br/>- api_cost_summary<br/>- meta<br/>- script_path"]

    STREAMS["Streams (9)<br/>scout_output<br/>forge_output<br/>furnace_feed<br/>furnace_output<br/>furnace_crash<br/>dissect_output<br/>arbiter_output<br/>harbor_output<br/>orchestrator_output"]

    PATCH_QUEUE["patch_log_queue<br/>(Redis list, RPUSH)"]

    HEARTBEATS["heartbeat:*<br/>TTL 30s<br/>agent health"]

    METRICS["REDIS_STREAM_MESSAGES<br/>REDIS_STREAM_LAG<br/>REDIS_STREAM_PENDING"]
  end

  subgraph CHROMA["ChromaDB (port 8000, 0.5.0)"]
    PM["Collection: patch_memory<br/>- patch_id, job_id<br/>- exception_type, message<br/>- category, repair_strategy<br/>- diff_applied (document)<br/>- outcome<br/>- embedding: sentence-transformers<br/>  all-MiniLM-L6-v2<br/>- query: top-K=3, where=category"]

    AM["Collection: architecture_memory<br/>- decision_id, job_id<br/>- modality, task_type<br/>- num_rows, imbalance_ratio<br/>- model_selected<br/>- imbalance_strategy<br/>- outcome_metric, outcome_label<br/>- embedding: all-MiniLM-L6-v2<br/>- query: top-K=3, where=modality+task"]

    TM["Collection: tool_memory<br/>- tool_id, agent_name<br/>- tool_name, docstring<br/>- source_file<br/>- embedding: all-MiniLM-L6-v2<br/>- query: top-K=5, semantic search"]
  end

  subgraph FS["File System"]
    SCRIPTS["scripts/<br/>training_script_{job_id}.py<br/>generated by Forge"]

    DATA["data/<br/>dataset CSVs (*.csv)<br/>scout converts .xls→.csv"]

    OUTPUTS["outputs/{job_id}/<br/>checkpoints/<br/>  best.ckpt<br/>  y_test.npy<br/>  y_pred.npy<br/>  y_prob.npy<br/>serving/<br/>  model.onnx<br/>  app.py<br/>  Dockerfile<br/>  deploy_config.json<br/>eval_report_{job_id}.json<br/>diagnostic_{job_id}.json"]

    RESEARCH["research/<br/>patch_log.jsonl<br/>benchmark/problems.json<br/>benchmark/results/*.json"]
  end

  subgraph PATCH_FLOW["Patch Log Flow"]
    DISSECT_WRITE["Dissect writes<br/>PatchLogEntry JSON"]
    REDIS_QUEUE["Redis RPUSH<br/>patch_log_queue"]
    WRITER["Patch Log Writer<br/>BLPOP + FileLock"]
    JSONL["research/patch_log.jsonl<br/>(append-only)"]

    DISSECT_WRITE --> REDIS_QUEUE
    REDIS_QUEUE -->|"background task"| WRITER
    WRITER --> JSONL
  end

  subgraph AGENTS_IO["Agents ↔ Storage"]
    S_R["Scout → Redis<br/>writes MissionBrief<br/>job:{id}:mission_brief"]
    F_R["Forge → Redis<br/>writes search_space<br/>job:{id}:search_space"]
    F_C["Forge → ChromaDB<br/>queries architecture_memory<br/>stores decision"]
    D_C["Dissect → ChromaDB<br/>queries patch_memory (K=3)<br/>stores new patch"]
    D_R["Dissect → Redis<br/>writes patch_log_queue"]
    H_R["Harbor → Redis<br/>reads checkpoint path<br/>writes serving config"]
    A_C["Arbiter → ChromaDB<br/>stores outcome<br/>architecture_memory<br/>outcome_label"]
  end

  AGENTS_O["Orchestrator → Redis<br/>sets job status,<br/>reads/writes all keys"]

  PM -.-> D_C
  AM -.-> F_C
  TM -.-> F_C
  AM -.-> A_C
  PATCH_QUEUE -.-> D_R

  style REDIS fill:#d4f9d4
  style CHROMA fill:#d4f9d4
  style FS fill:#f0f0f0
  style PATCH_FLOW fill:#f9d4d4
  style AGENTS_IO fill:#d4f1f9
